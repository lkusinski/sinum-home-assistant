[Unit]
Description=Sinum push events to Home Assistant (Z2M bridge)
After=network-online.target sinum-z2m.service
Wants=network-online.target

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/homeassistant-b7/github/sinum-home-assistant/bridge
EnvironmentFile=/home/dev/.config/sinum-z2m.env
ExecStart=/usr/bin/python3 /home/dev/homeassistant-b7/github/sinum-home-assistant/bridge/event_worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
